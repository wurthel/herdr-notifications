# Copy to "$(herdr plugin config-dir herdr-notifications)/.env" and chmod 600.
# Process environment variables override values from this file.

# Bot token from @BotFather (required).
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token

# Chat to send to: your user id, a group id (negative), or @channelname (required).
TELEGRAM_CHAT_ID=replace-with-your-chat-id

# Comma-separated statuses that trigger a message.
# Valid: idle, working, blocked, done.
NOTIFY_ON=done,blocked

# Report working -> idle as "done". herdr says idle instead of done when the
# pane is visible as the agent finishes. Requires done in NOTIFY_ON. 0 disables.
NOTIFY_IDLE_AFTER_WORKING=1

# Pane output lines to send when no Claude Code / Codex transcript is found
# (max 200). 0 disables this fallback.
PANE_TAIL_LINES=15

# Minimum seconds between two messages for the same status on the same pane.
DEBOUNCE_SECONDS=10

# 1 (or true) overwrites $HERDR_PLUGIN_STATE_DIR/debug/last-event.json.
DEBUG=0

# Override the Bot API base URL (tests or a self-hosted Bot API server).
# TELEGRAM_API_BASE=https://api.telegram.org
